# For `docker compose` only (separate from the app's own .env.example / .env.local used by
# `npm run dev`). Copy to `.env` in this directory before running `docker compose up --build`
# — docker compose auto-loads a file named exactly `.env`.
#
# Every value here has a working default baked into docker-compose.yml — override only what's
# different for your setup.

APP_ENV=development

# invoicing-be runs as its OWN separate compose stack (see invoicing-be/docker-compose.yml).
# These defaults assume it's reachable on localhost:8090 — the port that stack publishes to
# your host machine by default (INVOICE_BE_PORT there).
NEXT_PUBLIC_INVOICE_API_URL=http://localhost:8090/api/v1
INVOICE_API_INTERNAL_URL=http://host.docker.internal:8090/api/v1

# SSO / Launchpad — separate products, not started by any of this. Point these at wherever
# your SSO/Launchpad actually run (e.g. a local Laragon vhost).
NEXT_PUBLIC_AUTH_API_URL=http://sso.test/api
NEXT_PUBLIC_LAUNCHPAD_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3010
NEXT_PUBLIC_COOKIE_DOMAIN=

INVOICE_FE_PORT=3010

# PDF export tuning (optional, Playwright — see Dockerfile)
PDF_MAX_CONCURRENCY=2
PDF_QUEUE_TIMEOUT_MS=20000
PDF_RENDER_TIMEOUT_MS=30000
